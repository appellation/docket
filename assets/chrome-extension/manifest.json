{
  "manifest_version": 3,
  "name": "Docket",
  "description": "Opens GitHub pull requests in Docket: those in your docket, and those in your projects' repositories.",
  "version": "1.1.0",
  "key": "",
  "permissions": ["nativeMessaging", "webNavigation", "storage", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Docket: opening pull requests here"
  },
  "icons": {
    "16": "icons/docket-16.png",
    "32": "icons/docket-32.png",
    "64": "icons/docket-64.png",
    "128": "icons/docket-128.png"
  }
}
